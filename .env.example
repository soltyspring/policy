# 키는 backend/.env 또는 .env에 넣어요(둘 다 저장소에 올라가지 않아요).

# ── 미니앱(빌드) ─────────────────────────────
# 서버 API HTTPS 기본 주소. 개발에서는 비워 두면 Vite proxy를 써요.
VITE_API_BASE_URL=
# 새 정책 알림 캠페인 발송 코드(policy-로 시작). 비워 두면 앱이 알림 동의를 받지 않아요.
VITE_TOSS_NEW_TEMPLATE=

# ── 서버 API ─────────────────────────────────
PORT=3003
HOST=127.0.0.1
# 비우면 policy.apps / private-apps / web / private-web .tossmini.com
ALLOWED_ORIGINS=
POLICY_DB_PATH=.data/policy.sqlite
# 주 1회 새로 받은 지역 목록 위치(없으면 shared/regions.json)
REGIONS_PATH=
REGIONS_OUT=
COLLECT_INTERVAL_HOURS=6

# ── 데이터 출처 ──────────────────────────────
# 온통청년 Open API 인증키 (youthcenter.go.kr 마이페이지)
YOUTH_API_KEY=
# 공공데이터포털 일반 인증키(Decoding). 대한민국 공공서비스(혜택) 정보 활용신청 필요
DATA_GO_KR_API_KEY=
# 도로명주소 검색 API 승인키 (business.juso.go.kr). 지역 목록 확인과 동네 찾기(동 이름·도로명)에 써요
JUSO_API_KEY=

# ── 새 정책 알림(지금은 꺼 둠) ────────────────
NOTIFY_ENABLED=false
TOSS_NEW_TEMPLATE=
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# true면 토스 API 대신 가짜 응답(개발 전용, 운영에서는 거부)
TOSS_MOCK=true
# 개발 화면용 예시 정책
POLICY_SEED_DEMO=false
